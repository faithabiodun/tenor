# Foundry
contracts/out/
contracts/cache/
# Foundry nests these as broadcast/<script>/<chainId>/dry-run/, so the glob needs to span
# more than one level. Real broadcast receipts are worth keeping; simulations are not.
contracts/broadcast/**/dry-run/

# Node
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Env & secrets
.env
.env.local
.env*.local
!.env.example

# Agent run cache (keyed by document hash, see section 12 of the spec)
.cache/

# OS / editor
.DS_Store
Thumbs.db
*.log
