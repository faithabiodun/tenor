# Copy to .env and fill in. Never commit .env.

# --- X Layer ---------------------------------------------------------------
# Chain ids confirmed with eth_chainId against the live RPCs on 10 Aug 2026.
# Testnet is 1952. The 195 testnet in most chain lists is the retired zkEVM one.
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech

# Deployer. This key becomes the contract owner, i.e. the underwriting service
# that records verdicts, so the backend must hold the same key.
# Prefer a Foundry keystore over a raw key:
#   cast wallet import uptime-deployer --interactive
#   forge script ... --account uptime-deployer
DEPLOYER_PRIVATE_KEY=

# OKLink (X Layer explorer) API key, for contract verification.
# https://www.oklink.com/account/my-api
OKLINK_API_KEY=

# --- Agents ----------------------------------------------------------------
# Bull, bear and arbiter are text in, text out, and run on DeepSeek, which speaks the
# OpenAI wire format. This is where the AI budget actually goes: the debate is re-run
# dozens of times against the same documents during prompt tuning.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Extraction reads an uploaded PDF or photo, so it needs vision. DeepSeek does not expose
# image input on its public API, so this leg runs on Claude. It is cheap in practice:
# extraction results are cached to disk by document hash and run about once per document.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5

# --- Supabase --------------------------------------------------------------
# Stores the reasoning behind each verdict. Without it the pipeline still prices, but a
# verdict hash on chain commits to reasoning nobody can produce, which is the whole claim.
# The service role key bypasses row level security and must stay server side: there is no
# anon insert policy on any Uptime table, deliberately.
SUPABASE_URL=https://svbqoplujdigkbmwxvib.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=1952
NEXT_PUBLIC_CONTRACT_ADDRESS=0xE0a24398Ba9A70a3B930B2dd2A69E4F8eda44b00
